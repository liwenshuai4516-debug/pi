{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Agent SDK + Electron + TypeScript agent client",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm start",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*/*.test.mjs",
    "test:electron": "npm run build && node tests/electron/flow.mjs",
    "package": "npm run build && electron-builder --mac dir --publish never"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "dompurify": "3.4.17",
    "marked": "18.0.11",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "25.3.0",
    "@types/proper-lockfile": "4.1.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "local.pi.agent.desktop",
    "productName": "Pi Agent",
    "npmRebuild": false,
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "44.9.0"
  }
}
